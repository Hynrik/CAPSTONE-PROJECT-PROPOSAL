PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Local MySQL defaults
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aipge_db
DB_SSL=false

