PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Local MySQL defaults
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aipge_db
DB_SSL=false

# TiDB Cloud production values
# DB_HOST=your-tidb-host
# DB_PORT=4000
# DB_USER=your-tidb-user
# DB_PASSWORD=your-tidb-password
# DB_NAME=aipge_db
# DB_SSL=true

# Use smtp for localhost or resend for deployment.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email

# Recommended on Render: use Resend's HTTPS API instead of SMTP.
RESEND_API_KEY=re_your_api_key
RESEND_FROM="AIPGEF <noreply@your-verified-domain.com>"
